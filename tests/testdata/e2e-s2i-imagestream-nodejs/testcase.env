# Test case: S2I BuildConfig with ImageStream builder and output references.
#
# Sourced by tests/e2e-cluster.sh. Every value may be overridden from the
# environment (the `${VAR:-default}` form lets a global export win), so CI or a
# developer can point the case at a different builder image or registry.

# Resource identity — must match metadata in buildconfig.yaml.
NAMESPACE="${NAMESPACE:-my-app}"
BUILD_NAME="${BUILD_NAME:-sample-nodejs}"

# Concrete values the ImageStream/registry references resolve to during transform.
BUILDER_IMAGE="${BUILDER_IMAGE:-registry.access.redhat.com/ubi9/nodejs-18:latest}"
REGISTRY="${REGISTRY:-registry.kube-system.svc.cluster.local:80}"

# ClusterBuildStrategy the converted Build targets. This is the plugin's default
# S2I strategy: it uses only public images (quay.io s2i + gcr.io kaniko) so CI can
# pull them without Red Hat registry credentials. Its push is Shipwright-managed,
# so it declares only builder-image and rejects the registries-insecure param;
# the converter routes insecure-registries to spec.output.insecure for it instead.
BUILD_STRATEGY="${BUILD_STRATEGY:-source-to-image}"

# crane transform optional flags (JSON). References the vars above so overrides
# propagate. OCP_REGISTRY is exported by the runner. No default-build-strategy
# override needed — source-to-image is already the plugin default. Listing the
# in-cluster registry as insecure makes the converter set spec.output.insecure
# on this Shipwright-managed push (it would be a registries-insecure param on a
# buildah build).
OPTIONAL_FLAGS="{\"imagestream-mapping\":\"openshift/nodejs:18-ubi8=${BUILDER_IMAGE}\",\"registry-mapping\":\"${OCP_REGISTRY}=${REGISTRY}\",\"insecure-registries\":\"${REGISTRY}\"}"

# Cluster + build assertions.
EXPECT_REGISTERED=true      # Shipwright must register the applied Build
RUN_BUILDRUN=true           # create a BuildRun and wait for its result
EXPECT_BUILDRUN=Succeeded   # expected terminal BuildRun condition
BUILD_TIMEOUT="${BUILD_TIMEOUT:-900s}"
